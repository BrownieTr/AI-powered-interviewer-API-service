# Copy this file to `.env` in this folder and fill in real values.
# Never commit `.env` or paste a real HF_TOKEN into this example file.

PORT=3001
CLIENT_ORIGIN=http://localhost:5173

# At least 32 characters. Use a long random string in production.
JWT_SECRET=dev-only-change-this-to-a-long-random-secret-string
JWT_EXPIRES_IN=7d

# Hugging Face: https://huggingface.co/settings/tokens (read access is enough)
HF_TOKEN=hf_your_token_here

# Hub model id — check the model page for "Inference Providers" (Qwen2.5-3B-Instruct often has none).
# 1.5B is served (e.g. featherless-ai); 7B often has together + featherless.
HF_MODEL=Qwen/Qwen2.5-1.5B-Instruct

# Optional: pin a provider, e.g. featherless-ai | together | nebius
# HF_PROVIDER=featherless-ai

# SQLite database file (created automatically)
DATABASE_PATH=./data/app.db
